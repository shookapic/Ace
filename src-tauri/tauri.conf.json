{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ace",
  "version": "0.1.4",
  "identifier": "com.foxolf.ace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ace",
        "width": 420,
        "height": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGRTYzM0ZBNzc1ODdDNjAKUldSZ2ZGaDMralBtSDdUUWtlVldXQklUeERzN2hjbUc4dU1OT1ZidzhoR21NcnJrTG9jVGtWZGIK",
      "endpoints": [
        "https://github.com/shookapic/Ace/releases/latest/download/latest.json"
      ]
    }
  }
}
